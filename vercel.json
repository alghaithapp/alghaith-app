{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/assets/:path*",
      "destination": "/admin/assets/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    }
  ]
}
