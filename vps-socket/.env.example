# VPS Socket.io Server — متغيرات البيئة
# انسخ إلى .env واملأ القيم الفعلية

# منفذ الخادم (داخل VPS)
PORT=3001

# اتصال Redis (محلي)
REDIS_URL=redis://127.0.0.1:6379

# مفتاح أمان لـ POST /api/broadcast (غيّره لقيمة عشوائية)
BROADCAST_KEY=alghaith-socket-broadcast-key

# IPv4 العام
VPS_IP=155.117.43.250
# منفذ NAT العام (الخارجي)
VPS_PUBLIC_PORT=10035
# بيانات SSH — احصل عليها من لوحة تحكم المزوّد
VPS_SSH_PORT=10034
VPS_USER=administrator
VPS_PASSWORD=your-password-here
